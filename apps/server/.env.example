# ── Grocerun server environment ─────────────────────────────────────────────
# This file documents every variable validated by apps/server/src/config.ts.
# Copy to .env and adjust. All variables are optional unless marked REQUIRED.
# Unknown variables are ignored; invalid values fail fast at boot.

# Runtime environment: dev | test | prod
# NODE_ENV=dev

# HTTP port the API listens on
# PORT=3001

# SQLite/Postgres connection string
# DATABASE_URL=file:../web/dev.db

# Allowed CORS origin for the web app
# WEB_URL=http://localhost:3000

# Version reported by GET /health (e.g. a git short SHA)
# APP_VERSION=dev

# Optional absolute path to the built SPA directory served in production.
# When unset, the server searches for apps/web/dist automatically.
# SPA_DIST_DIR=/absolute/path/to/web/dist

# OIDC Issuer URI
# Google (default): https://accounts.google.com
# Authentik (local smoke test): http://localhost:9000/application/o/grocerun/
# Other providers: check your IdP's .well-known/openid-configuration
OIDC_ISSUER_URI=https://accounts.google.com

# OIDC Audience — must equal the OIDC client ID (same value as VITE_OIDC_CLIENT_ID)
# REQUIRED in dev and prod — every feature is auth-gated, so there is no
# legitimate mode that runs without audience validation. Only NODE_ENV=test
# (hermetic local-JWT bypass) runs without it.
# OIDC_AUDIENCE=YOUR_CLIENT_ID_HERE

# OIDC Provider name — used for Account records (default: google)
# Set to 'authentik', 'keycloak', etc. when using a non-Google provider
# OIDC_PROVIDER=google

# Database driver seam (default: sqlite). Driver logic lands in GROCERUN-53.
# DB_DRIVER=sqlite

# Storage driver seam (default: local). Storage logic lands in a later ticket.
# STORAGE_DRIVER=local

# Local storage root when STORAGE_DRIVER=local
# STORAGE_LOCAL_FS_PATH=./storage
